rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['ariane.lignier@gmail.com'];
    }
    function validPost() {
      let d = request.resource.data;
      return d.keys().hasAll(['title', 'slug', 'date', 'body', 'published'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.slug is string && d.slug.size() <= 120
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.body is string && d.body.size() <= 100000
        && d.published is bool;
    }
    match /posts/{postId} {
      // Anyone can read published articles; the admin can also read drafts.
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && validPost() && request.resource.data.slug == postId;
      allow delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
